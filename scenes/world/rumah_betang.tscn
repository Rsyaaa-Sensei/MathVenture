[node name="NPC" parent="YSort" unique_id=906111625 instance=ExtResource("5_npc")]
y_sort_enabled = true
position = Vector2(-308, 379)
scale = Vector2(0.2, 0.2)
npc_name = "Tempong"
player_name = "Jati"
sprite_frames = ExtResource("6_tempong")
lines = Array[String](["Tempong|Selamat datang di Rumah Betang kami, anak muda! Rumah panjang ini dihuni oleh puluhan keluarga secara bersama-sama dalam harmoni. Karena ukurannya yang sangat panjang, para tetua sering mendiskusikan berapa besar volume udara di dalam ruangan utama saat musyawarah adat berlangsung.", "Jati|Wah, arsitekturnya luar biasa megah, Kek! Bentuk atap pelananya yang memanjang ke belakang itu kelihatan unik sekali. Kalau kita amati secara geometris, bangunan ini mirip bangun ruang apa ya, Kek?", "Tempong|Pikiranmu tajam, Jati! Sebelum kita hitung volumenya bersama-sama, mari kita bedah terlebih dahulu bentuk geometris dari struktur bangunan ini. Dekati atapnya dan amati bagian-bagiannya, ya."])
wander_radius = 80.0

