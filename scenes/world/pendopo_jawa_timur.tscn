position = Vector2(56.999996, 445)
scale = Vector2(0.2, 0.2)
npc_name = "Mbok Ratih"
player_name = "Arka"
sprite_frames = ExtResource("6_mbok")
lines = Array[String](["Mbok Ratih|Sugeng rawuh, Nak Arka! Selamat datang di bumi Jawa Timur. Menjelang tradisi sedekah bumi hari ini, saya sedang membuat Kue Iwel-iwel, kue tradisional legit kesukaan warga. Tapi, saya harus menghitung takaran adonan dan luas pembungkus daun pisangnya agar bentuk limasnya sempurna dan tidak ada bahan yang terbuang.", "Arka|Wah, aromanya harum sekali, Mbok! Bentuk bungkusnya unik, mengerucut ke atas. Biar saya bantu menganalisis bentuk geometris dan volumenya dengan konsep matematika!", "Mbok Ratih|Matur nuwun, Nak! Dekati kue Iwel-iwel di meja itu dan amati bagian-bagiannya, ya. Dari situ kamu bisa menyelidiki rahasia bangun limas."])
wander_radius = 80.0

