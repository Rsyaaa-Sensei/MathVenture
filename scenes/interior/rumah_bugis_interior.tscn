[node name="NPC" parent="YSort" unique_id=944825383 instance=ExtResource("10_vjmgf")]
y_sort_enabled = true
position = Vector2(-194, -172)
scale = Vector2(0.1, 0.1)
sprite_frames = SubResource("SpriteFrames_sspvn")
lines = Array[String]([" Amure|Tari, cucuku. Coba lihat peti kayu tempat menyimpan Songko To Bone ini. Bentuknya pas, simetris, dan tidak mudah goyah. Leluhur kita dulu merancangnya bukan sembarangan, lho", "Tari|Wah, iya Kek! Dari dulu Tari penasaran, kenapa peti penyimpan songkok adat bentuknya selalu kotak yang seimbang begini ya? Pasti ada rahasia ukurannya.", "Amure|Tentu saja ada! Sebelum kita isi penuh dengan songkok hasil tenunan terbaru, bagaimana kalau kamu bantu Kakek membedah rahasia bentuk dan isi peti ini secara matematis?", "Tari|Siap, Kek! Tantangan diterima! "])
wander_radius = 100.0

